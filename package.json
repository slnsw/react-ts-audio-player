{
  "name": "@slnsw/react-ts-media-player",
  "version": "0.3.0",
  "description": "React component representing an audio/video player.",
  "type": "module",
  "typings": "dist/index.d.ts",
  "source": "index.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "rm -rf dist/* && parcel build",
    "web-bundle": "rm -rf dist/* && tsc && webpack",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prettier": "pnpm format",
    "lint": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "browsersync": "npm run web-bundle && npm run browsersync:run",
    "browsersync:run": "browser-sync start --server --startPath example.html --files . --config bs-config.js",
    "test": "vitest",
    "vitest:ci": "vitest run --coverage --reporter=verbose",
    "cspell": "cspell '**'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "debounce": "^2.0.0",
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^16.12.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.12.0 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@babel/core": "^7.7.7",
    "@babel/preset-env": "^7.7.7",
    "@babel/preset-react": "^7.7.4",
    "@babel/register": "^7.7.7",
    "@eslint/js": "^10.0.1",
    "@parcel/babel-preset-env": "^2.16.4",
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "@testing-library/react": "^16.3.3",
    "@types/debounce": "^1.2.0",
    "@types/node": "^13.1.4",
    "@types/react": "^16.14.60",
    "@types/react-dom": "^16.9.4",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^2.15.0",
    "@typescript-eslint/parser": "^2.15.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-loader": "^8.0.6",
    "browser-sync": "^3.0.2",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "parcel": "^2.16.4",
    "prettier": "^1.19.1",
    "ts-loader": "^6.2.1",
    "tsdx": "^0.13.2",
    "typescript": "^4.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "webpack": "^4.41.5",
    "webpack-cli": "^3.3.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slnsw/react-ts-audio-player.git"
  },
  "packageManager": "pnpm@10.30.3"
}
